# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Placeholders only. Never commit real values.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public anon / publishable key. Safe for browsers ONLY because Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public URL of this app (used in email links). Local: http://localhost:3000
# On Vercel use your production domain. Preview deployments fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after Google is enabled in Supabase Auth > Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Phase 2 does NOT use the Supabase service-role key. Do not add it here.
# If a later phase needs it, add it as a server-only variable (no NEXT_PUBLIC_ prefix).

# ---------------------------------------------------------------------------------------------
# Phase 3: AI invoice extraction. ALL of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix).
# Full documentation: docs/PHASE3_SETUP.md
# ---------------------------------------------------------------------------------------------

# Supabase > Project Settings > API > service_role key. Bypasses Row Level Security. Never expose it,
# never commit it. Phase 3 needs it because only server code may write extraction results, jobs and usage.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google AI Studio > Get API key. Required for extraction. Without it the extract/enqueue routes answer 503.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model and list prices (USD per 1M tokens), used for the approximate cost records.
# Defaults were checked on 11 Oct 2026. Re-check https://ai.google.dev/gemini-api/docs/pricing before launch.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_INPUT_PRICE_PER_MTOK=0.30
GEMINI_OUTPUT_PRICE_PER_MTOK=2.50

# Timeouts and retries
GEMINI_TIMEOUT_MS=40000            # per provider call
EXTRACTION_DEADLINE_MS=52000       # total per invoice; keep below the route maxDuration (60 s)
EXTRACTION_MAX_ATTEMPTS=3          # provider calls per run (retries on 429/5xx/timeout/invalid output)
GEMINI_MAX_OUTPUT_TOKENS=32768
EXTRACTION_VERIFY=on                 # second AI reading of every invoice, compared with the first (off = one call only)

# Limits (enforced on the server / in the database)
# NOT USED since Phase 5: the invoice quota and files per upload come from the plans table (see docs/PHASE5_SETUP.md).
# EXTRACTION_BATCH_MAX_FILES=10
# EXTRACTION_MONTHLY_LIMIT=200
EXTRACTION_PER_MINUTE_LIMIT=20         # jobs queued per firm per minute
EXTRACTION_MAX_CONCURRENT=3            # jobs processing at the same time per firm
EXTRACTION_MAX_RUNS_PER_INVOICE=3      # first run + manual retries
EXTRACTION_UPLOADS_PER_DAY=300         # uploaded files per firm per rolling 24 h
EXTRACTION_STALE_SECONDS=180           # a "processing" job older than this is failed so it can be retried
EXTRACTION_MAX_PDF_PAGES=10

# Review checks
EXTRACTION_LOW_CONFIDENCE=0.8          # field confidence below this is flagged
EXTRACTION_TOLERANCE_PAISE=100         # arithmetic tolerance (100 = INR 1.00)

# ---------------------------------------------------------------------------------------------
# Phase 5: plans and billing. Plan prices and limits live in the database (plans table), not here.
# Full documentation: docs/PHASE5_SETUP.md. No payment gateway is connected yet, so there are no gateway keys.
# ---------------------------------------------------------------------------------------------

# TESTING ONLY. When "true", an owner or admin can upgrade to a paid plan WITHOUT paying.
# It is ignored on Vercel Production and on any production build outside Vercel, but it IS honoured on
# Vercel Preview deployments. Leave it unset (or false) everywhere that holds real customer data.
BILLING_ALLOW_UNPAID_UPGRADES=false

# ---------------------------------------------------------------------------------------------
# Phase 6 Part 1: cloud integrations and accounting export. ALL SERVER-ONLY. Docs: docs/PHASE6_PART1_SETUP.md
# ---------------------------------------------------------------------------------------------

# 32 random bytes, base64. Encrypts the stored Google/Microsoft tokens (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means every user must reconnect. Never commit it. Needs SUPABASE_SERVICE_ROLE_KEY too.
INTEGRATION_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY
# Only while rotating the key: the old key, used for decrypting only.
# INTEGRATION_ENCRYPTION_KEY_PREVIOUS=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application). Enable the Google Sheets API.
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/integrations/oauth/google_sheets/callback
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Microsoft Entra admin centre > App registrations (Web platform). Delegated permissions: Files.ReadWrite, offline_access, openid, profile, email.
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/integrations/oauth/microsoft_excel/callback
MICROSOFT_OAUTH_CLIENT_ID=YOUR_APP_CLIENT_ID
MICROSOFT_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET_VALUE
# "common" = work/school and personal accounts. Or your tenant id to allow one organisation only.
MICROSOFT_OAUTH_TENANT=common

# EXPERIMENTAL and unverified against Tally. Leave unset/false in production until you have test-imported the file.
# The Tally export (Export page > Export as > Tally) is ON by default. Uncomment the next line only to turn it OFF.
# TALLY_EXPORT_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Phase 6 Part 2: local debugging only
# ---------------------------------------------------------------------------------------------
# Shows technical error text (database codes etc.) in API answers. Honoured ONLY by `next dev`; it is ignored in every
# production build (Vercel Production AND Preview). Leave it unset. Never set it on Vercel.
# AI_ASIS_DEBUG_ERRORS=1
